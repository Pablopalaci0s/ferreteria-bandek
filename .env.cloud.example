# ---------------------------------------------------------------------------
# Plantilla de .env para el stack 100% gratuito: Render (Docker) + Neon
# (Postgres) + Supabase Storage (imágenes) + Resend (correo) + Google Drive
# (backups). Ver DEPLOY-CLOUD.md para el paso a paso completo.
#
# En Render esto NO se sube como archivo: cada variable se carga a mano en
# el dashboard (Environment). render.yaml ya deja declaradas las que
# necesitan valor tuyo con `sync: false`.
# ---------------------------------------------------------------------------

APP_NAME="Ferretería BANDEK"
APP_ENV=production
APP_KEY=                          # php artisan key:generate --show (generar una vez, pegar el resultado)
APP_DEBUG=false
APP_URL=https://tu-app.onrender.com   # o tu dominio propio si le apuntás uno

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=stderr                  # Render captura stdout/stderr como logs; no hay disco persistente para un log file
LOG_LEVEL=error

# --- Base de datos: Neon (Postgres) ---------------------------------------
# Neon te da UNA connection string; pegala completa en DB_URL y listo.
# USA LA CONEXIÓN DIRECTA (toggle "Connection pooling" apagado, sin
# "-pooler" en el host) — NO la "pooled". El pooler de Neon (PgBouncer en
# modo transaction pooling) falla de forma intermitente con las
# migraciones de Laravel. Ver DEPLOY-CLOUD.md.
DB_CONNECTION=pgsql
DB_URL=postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/bandek_db?sslmode=require
DB_SSLMODE=require

# --- Backups (php artisan db:backup) ---------------------------------------
# En Render (sin disco persistente) el backup local es temporal: se crea,
# se sube a Google Drive, y desaparece cuando el contenedor se reinicia.
# La copia off-site es la que importa acá.
DB_BACKUP_RETENTION_DAYS=14
DB_BACKUP_UPLOAD_DISK=google
DB_BACKUP_UPLOAD_FOLDER=bandek-backups
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Render free no tiene cron real: un cron externo gratuito (GitHub Actions o
# cron-job.org) golpea GET /cron/backup una vez al día con esta cabecera:
#   X-Cron-Secret: <este valor>
# Generalo con: php artisan tinker --execute="echo \Illuminate\Support\Str::random(40);"
CRON_SECRET=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true        # Render sirve todo por HTTPS

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database         # no hay jobs en cola hoy; no hace falta un worker aparte

CACHE_STORE=database

# --- Imágenes: Supabase Storage (S3-compatible, sin disco persistente) ----
# El disco "public" (productos/categorías/banners) usa el driver "local" si
# dejás esto vacío. En Render hace falta apuntarlo a Supabase Storage.
# (Supabase no pide tarjeta, a diferencia de Cloudflare R2 — pero su free
# tier pausa el proyecto tras una semana sin actividad; por eso el
# workflow de GitHub Actions supabase-keep-alive.yml es obligatorio acá.)
FILESYSTEM_DISK_PUBLIC=s3
AWS_ACCESS_KEY_ID=                # Project Settings > Data API > Storage > S3 Connection > New access key
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1      # la región que te haya asignado el dashboard de Supabase
AWS_BUCKET=bandek-imagenes
AWS_ENDPOINT=https://<PROJECT_REF>.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true
# URL pública del bucket (el bucket tiene que estar marcado "Public"):
AWS_URL=https://<PROJECT_REF>.supabase.co/storage/v1/object/public/bandek-imagenes

# --- Correo: Resend ----------------------------------------------------
MAIL_MAILER=resend
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM_ADDRESS="notificaciones@tu-dominio.com"
MAIL_FROM_NAME="Ferretería BANDEK"

VITE_APP_NAME="${APP_NAME}"
